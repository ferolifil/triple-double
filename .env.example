# =============================================================================
# triple-double — variáveis de ambiente
#
# Copie para .env e ajuste os valores:  cp .env.example .env
# O .env está no .gitignore e NUNCA deve ser commitado.
# Os valores abaixo servem apenas para desenvolvimento local.
# =============================================================================

# Nome do projeto no docker compose (prefixo de containers, volumes e rede)
COMPOSE_PROJECT_NAME=triple-double

# -----------------------------------------------------------------------------
# MinIO (object storage compatível com S3)
# -----------------------------------------------------------------------------
# Credenciais do usuário root. A senha precisa ter no mínimo 8 caracteres.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
# Portas expostas no host: API S3 e console web
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# Postgres (backend do Hive Metastore)
# -----------------------------------------------------------------------------
POSTGRES_USER=hive
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=metastore
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Hive Metastore
# -----------------------------------------------------------------------------
HIVE_METASTORE_PORT=9083

# -----------------------------------------------------------------------------
# Spark (cluster standalone)
# -----------------------------------------------------------------------------
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8080
SPARK_WORKER_UI_PORT=8081
# Recursos que o worker oferece ao cluster. Com ~20 GB para o Docker,
# 4 cores / 8 GB deixam folga para os demais serviços (Airflow, Superset...).
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=8g
